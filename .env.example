# Process environment configuration. This file is documentation, not auto-loaded.
# Export variables in your shell, or explicitly use uvicorn --env-file .env.
# Relative backend paths resolve against the repository root.
ENVIRONMENT=development
DATABASE_PATH=data/feedback.db
MODEL_PATH=artifacts/production.joblib
# sklearn is the default. PhoBERT requires both imported task runs; never silently falls back.
MODEL_BACKEND=sklearn
# PHOBERT_SENTIMENT_RUN=artifacts/runs/phobert-sentiment-20261106T185751304434Z
# PHOBERT_TOPIC_RUN=artifacts/runs/phobert-topic-20261106T191350538989Z
PHOBERT_CPU_THREADS=1
ALLOW_DEMO_MODEL=true
AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173

# Optional local auth. Use a random secret of at least 32 ASCII characters when enabled.
# Production requires API_TOKEN and ALLOW_DEMO_MODEL=false; do not put this token in VITE_*.
API_TOKEN=
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=1000
MAX_EXPORT_ROWS=5000
DATABASE_TIMEOUT=5

# Used by python -m backend.app serve (Uvicorn CLI uses its own host/port flags).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Optional: set a local font with Vietnamese coverage. No Helvetica fallback.
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf

# Frontend: place this variable in frontend/.env.local or export before running Vite.
VITE_API_URL=http://localhost:8000
