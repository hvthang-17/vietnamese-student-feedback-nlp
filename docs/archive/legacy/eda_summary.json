  "imbalance_risks": [
    {
      "aspect": "Cảm xúc (Sentiment) - Lớp Trung tính (Neutral)",
      "severity": "Cao (High)",
      "finding": "Lớp trung tính chỉ chiếm 5.86% (669 mẫu) trong khi Tích cực chiếm 60.9% (6958 mẫu). Tỷ lệ mất cân bằng lên tới ~10:1.",
      "impact": "Mô hình có nguy cơ cao bỏ sót (Recall thấp) nhãn neutral, làm sụt giảm mạnh chỉ số Macro F1.",
      "mitigation": "Sử dụng class_weight='balanced' trong LinearSVC/LogisticRegression; thiết lập ngưỡng phân lớp (threshold tuning) hoặc phạt trọng số loss (Weighted Cross-Entropy) khi huấn luyện Transformer."
    },
    {
      "aspect": "Chủ đề (Topic) - Lớp Giảng viên áp đảo (Lecturer Dominance)",
      "severity": "Cao (High)",
      "finding": "Chủ đề 'Giảng viên' (Lecturer) chiếm tới 77.09% (8808 mẫu), trong khi 'Khác' (Others) chỉ có 2.32% (265 mẫu).",
      "impact": "Mô hình có xu hướng thiên vị dự đoán vào 'lecturer'; lớp 'others' dễ bị phân loại nhầm.",
      "mitigation": "Đánh giá chi tiết Confusion Matrix riêng cho từng lớp; báo cáo cả Macro F1 lẫn F1-score từng lớp thay vì chỉ nhìn vào Accuracy."
    },
    {
      "aspect": "Độ dài câu và từ vựng viết tắt/tiếng lóng",
      "severity": "Trung bình (Medium)",
      "finding": "Phản hồi sinh viên thường ngắn (trung bình 12-18 từ), nhiều từ viết tắt học đường ('gv', 'thầy cô', 'ko', 'ktra', 'btvn') và câu đảo ngữ.",
      "impact": "TF-IDF cần n-gram (1, 2) để bắt cụm từ mang sắc thái (ví dụ: 'không tốt', 'quá nhanh'); PhoBERT cần bước tách từ tiếng Việt chuẩn trước khi tokenize.",
      "mitigation": "Áp dụng tiền xử lý chuẩn hóa khoảng trắng `normalize_text` đồng bộ cho mọi pipeline; sử dụng `sublinear_tf=True` trong TF-IDF."
    }
